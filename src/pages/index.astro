---
import Layout from "../layouts/Layout.astro";
import CareerExplorer from "../components/CareerExplorer";
import { career } from "../lib/career";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const pdfUrl = `${base}alessandro-lollo-cv.pdf`;
---

<Layout title="Alessandro Lollo · Data & Analytics Engineering">
  <CareerExplorer client:load career={career} base={base} pdfUrl={pdfUrl} />
  <noscript>
    <section class="no-script">
      <h2>A readable résumé, with or without JavaScript</h2>
      <p>
        The interactive filters require JavaScript.{" "}
        <a href={`${base}print/`}>Read the complete résumé</a>, or use the role
        links above.
      </p>
      {career.experience.map((job) => (
        <article>
          <h3>
            {job.role} · {job.company}
          </h3>
          <p>{job.period}</p>
          <div class="prose" set:html={job.html} />
        </article>
      ))}
    </section>
  </noscript>
</Layout>
